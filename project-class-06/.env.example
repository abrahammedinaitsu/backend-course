# Copy this file to .env and fill in your own values.
# The real .env is gitignored and must never be committed or shared.

# Supabase dashboard -> Connect. Copy the string shown there (do not type
# the hostname by hand). If the direct connection fails on your network,
# use the Session pooler string from the same dialog.
DATABASE_URL=

# Generate your own random value with:  npm run generate:secret
JWT_SECRET=

PORT=3000
