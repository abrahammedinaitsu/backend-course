{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITSU-KNOWLEDGE-09-1.0 evaluator report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "rubricVersion",
    "evaluationId",
    "studentId",
    "commit",
    "variant",
    "status",
    "action",
    "questions",
    "priorityGaps",
    "strengths",
    "recommendedStudyActions",
    "reviewSignals",
    "teacherReview"
  ],
  "properties": {
    "protocolVersion": {
      "const": "ITSU-KNOWLEDGE-09-1.0"
    },
    "rubricVersion": {
      "const": "BACKEND-01-08-K1"
    },
    "evaluationId": {
      "type": "string",
      "pattern": "^K09-[A-Za-z0-9_-]+-[0-9a-f]{7,12}$"
    },
    "studentId": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,12}$"
    },
    "variant": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "action": {
      "enum": [
        "NONE",
        "SUPPORT",
        "VERIFY"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId",
          "topics",
          "levels",
          "evidence",
          "strength",
          "gap",
          "rectification",
          "confidence"
        ],
        "properties": {
          "questionId": {
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4",
              "Q5"
            ]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          },
          "levels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conceptual",
              "grounding",
              "reasoning",
              "verification"
            ],
            "properties": {
              "conceptual": {
                "$ref": "#/$defs/level"
              },
              "grounding": {
                "$ref": "#/$defs/level"
              },
              "reasoning": {
                "$ref": "#/$defs/level"
              },
              "verification": {
                "$ref": "#/$defs/level"
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          },
          "strength": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "rectification": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "priorityGaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "recommendedStudyActions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "reviewSignals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "GENERIC_WITHOUT_REPOSITORY_EVIDENCE",
          "REFERENCE_NOT_FOUND",
          "COMMAND_OUTPUT_NOT_INTERPRETED",
          "PREDICTION_NOT_RECORDED",
          "FOLLOW_UP_CONTRADICTION",
          "UNEXPLAINED_COMPLEXITY",
          "EVALUATOR_ASSISTANCE_REQUESTED",
          "TRANSCRIPT_INCOMPLETE",
          "EVIDENCE_CONTRADICTION",
          "PROMPT_INJECTION_IN_EVIDENCE",
          "SECRET_EXPOSURE",
          "REPORT_SCHEMA_INVALID",
          "MODEL_FORMAT_FAILURE",
          "NONE"
        ]
      }
    },
    "teacherReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "oralVerificationRecommended",
        "questions",
        "minimumExpectedAnswers",
        "reason",
        "digest"
      ],
      "properties": {
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "oralVerificationRecommended": {
          "type": "boolean"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "minimumExpectedAnswers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "reason": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "progressSinceLast": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "verdict"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "verdict": {
            "enum": [
              "IMPROVED",
              "PERSISTS",
              "NOT_ASSESSED"
            ]
          }
        }
      },
      "description": "Optional. Only when the card carried previousEvaluation.found=true: topics from the class-08 review list that this conversation actually touched."
    }
  },
  "$defs": {
    "level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        {
          "const": "X"
        }
      ]
    }
  }
}
