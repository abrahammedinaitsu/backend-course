# Copia este archivo a `.env` y reemplaza los placeholders con TUS valores.
#
# Este archivo SÍ se sube al repositorio: documenta QUÉ variables existen, nunca sus valores.
# El `.env` real está ignorado por git y jamás debe compartirse (ni en capturas ni en chats).

# --- Base de datos (clase 04) -------------------------------------------------
# Forma: el Session pooler de Supabase, puerto 5432.
#   usuario : password @ host : 5432 / postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Identidad / JWT (clase 05) ----------------------------------------------
# Secreto de firma de los JWT del taller. Genera el TUYO aleatorio con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Nunca subas ni compartas el valor real: este placeholder no es una clave válida.
JWT_SECRET=replace-with-a-random-secret
JWT_ISSUER=backend-course-api
JWT_AUDIENCE=backend-course-client
JWT_TTL_SECONDS=3600

# --- CORS (entrega 05A) -------------------------------------------------------
# Origen EXACTO del frontend (esquema + host + puerto del dev server de Vite).
FRONTEND_ORIGIN=http://localhost:5173
