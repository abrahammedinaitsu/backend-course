# Class 07 — local configuration. Copy this file to .env and fill it in:
#   cp .env.example .env
#
# Use the SAME Supabase project you prepared in class 06: same database,
# same connection string, same secret. Nothing new to create.
#
# DATABASE_URL: copy it from the Supabase Connect dialog — never type it by
# hand. On IPv4-only networks use the Session pooler string from the same
# dialog. NEVER commit, paste or share the real value.
DATABASE_URL=

# JWT_SECRET: the secret from class 06 still works. If you lost it,
# generate a new one:  npm run generate:secret
JWT_SECRET=

# Port for the local HTTP server.
PORT=3000
